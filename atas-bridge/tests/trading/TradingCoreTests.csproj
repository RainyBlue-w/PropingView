<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AtasPath Condition="'$(AtasPath)' == ''">D:\Program Files\ATAS X</AtasPath>
    <OutputPath>../../../.build-check/atas-tests/trading/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <ProjectReference Include="../../TvAtasBridge.csproj" />
    <AssemblyMetadata Include="AtasPath" Value="$(AtasPath)" />
    <Reference Include="ATAS.DataFeedsCore"><HintPath>$(AtasPath)\ATAS.DataFeedsCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Utils.Common"><HintPath>$(AtasPath)\Utils.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
